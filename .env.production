# ====== HawalaSend Backend - Production ======
NODE_ENV=production
PORT=3000

# ====== Database Configuration (Railway) ======
# Railway will auto-inject DATABASE_URL in production
DATABASE_URL=${DATABASE_URL}

# ====== Application Security (Production) ======
# Use Railway's environment variables for secrets
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ====== Email Configuration (Production) ======
EMAIL_FROM=HawalaSend <noreply@hawalasend.com>

# ====== Frontend URLs (Production) ======
FRONTEND_URLS=https://hawalasend.vercel.app

# ====== Rate Limiting (Production) ======
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_RATE_LIMIT_MAX=5
API_RATE_LIMIT_MAX=100

# ====== Security Policies (Production) ======
MIN_PASSWORD_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_TIME=15

# ====== Feature Flags (Production) ======
FEATURE_2FA_ENABLED=true
FEATURE_EMAIL_VERIFICATION=true
MAINTENANCE_MODE=false

# ====== Logging (Production) ======
LOG_LEVEL=info
LOG_FORMAT=json

# ====== Production Settings ======
TRUST_PROXY=1
MAX_TRANSACTION_AMOUNT=10000